:80 {
    encode gzip zstd
    handle /api/* {
        reverse_proxy api:8000
    }
    handle /privacy-policy {
        rewrite * /privacy-policy/index.html
        root * /srv
        file_server
    }
    handle {
       
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
