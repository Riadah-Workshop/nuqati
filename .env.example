# Environment variables for the PRODUCTION stack (compose.yml on Coolify).
# Copy to `.env` for a local run of compose.yml, or enter the same names in Coolify.
# `.env` is git-ignored. NEVER commit real values, and never put real values in this file.
#
# The LOCAL development stack (docker-compose.yml, `make up`) needs none of this.

# ── Database ──────────────────────────────────────────────────────────
POSTGRES_USER=nuqati
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nuqati

# Keep the historical default unless you are pointing at an existing, backed-up volume.
# Pointing Compose at a new name creates an EMPTY database. See docs/DEPLOY_COOLIFY.md.
# NUQATI_PG_VOLUME_NAME=

# ── API ───────────────────────────────────────────────────────────────
# Signs every login token; at least 32 characters. Changing it signs everyone out.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
NUQATI_AUTH_SECRET=
# Only while rotating the secret above: put the OLD value here for 30 days so signed-in users are not logged out,
# then remove it. Steps: docs/compliance/SECRET_ROTATION.md. Leave empty in an emergency rotation.
# NUQATI_AUTH_SECRET_PREVIOUS=
# Interactive API docs (/docs). Off unless set; docker-compose.yml (local) turns it on, compose.yml (production) never does.
# NUQATI_ENABLE_API_DOCS=1

# The HTTPS address users open. Also used for CORS and for links in emails.
NUQATI_PUBLIC_ORIGIN=https://nuqati.example.com

# IP/CIDR of the trusted reverse proxy that sets X-Forwarded-For (default: loopback only).
# NUQATI_TRUSTED_PROXIES=127.0.0.1/8,::1/128

# ── Email (invitations, password reset, alerts, scheduled reports) ────
# NUQATI_SMTP_HOST=
# NUQATI_SMTP_PORT=587
# NUQATI_SMTP_USER=
# NUQATI_SMTP_PASSWORD=
# NUQATI_EMAIL_FROM=noreply@example.com

# ── WhatsApp webhook (optional) ───────────────────────────────────────
# NUQATI_WHATSAPP_VERIFY_TOKEN=
# NUQATI_WHATSAPP_APP_SECRET=

# ── Web build ─────────────────────────────────────────────────────────
# Map tiles. Required by compose.yml at build time. Restrict the key by domain in MapTiler.
VITE_MAPTILER_API_KEY=

# ── Teltonika tracker receiver (optional hardware) ────────────────────
# Bound to loopback by default. For direct internet exposure set the bind host AND an allow-list;
# a private APN or VPN is strongly preferred (the IMEI handshake is not authentication).
# TELTONIKA_BIND_HOST=127.0.0.1
# TELTONIKA_ALLOWED_CIDRS=
# TELTONIKA_MAX_DB_CONCURRENCY=16

# ── Database backups (db_backup service in compose.yml) ───────────────
# One dump per day into the nuqati_backups volume. 23:00 UTC = 02:00 in Riyadh.
# NUQATI_BACKUP_HOUR_UTC=23
# Dumps older than this many days are deleted (the newest 3 are always kept).
# NUQATI_BACKUP_KEEP_DAYS=14

# ── Off-server copy of the backups (docs/compliance/BACKUP_RESTORE.md section 2b) ──────
# Off by default: nothing leaves the server until NUQATI_OFFSITE is set. Each dump is ENCRYPTED on the server before it is
# uploaded (rclone crypt), so Google Drive only ever holds files it cannot read.
#   NUQATI_OFFSITE=drive   (Google Drive; `local` copies to a folder, for tests or a second disk)
# NUQATI_OFFSITE=
# Folder in the destination (a plain name like nuqati-backups; an absolute folder for `local`).
# NUQATI_OFFSITE_PATH=nuqati-backups
# The encryption key: two DIFFERENT random passphrases of at least 16 characters each. KEEP A COPY OF BOTH IN YOUR PASSWORD
# MANAGER, OFF THIS SERVER: without them the copies cannot be decrypted, by anyone, ever.
# NUQATI_OFFSITE_PASSWORD=
# NUQATI_OFFSITE_PASSWORD2=
# Copies older than this many days are deleted at the destination (the newest 3 are always kept); the container turns
# unhealthy when the last good copy is older than MAX_AGE_HOURS.
# NUQATI_OFFSITE_KEEP_DAYS=30
# NUQATI_OFFSITE_MIN_KEEP=3
# NUQATI_OFFSITE_MAX_AGE_HOURS=50
# Google Drive, EITHER a service account on a Shared Drive (Google Workspace): the key file on ONE line + the Shared Drive's id
# NUQATI_OFFSITE_DRIVE_SERVICE_ACCOUNT_JSON=
# NUQATI_OFFSITE_DRIVE_SHARED_DRIVE_ID=
# OR your own OAuth client (personal Google account): client id, client secret and the token JSON printed by rclone
# NUQATI_OFFSITE_DRIVE_CLIENT_ID=
# NUQATI_OFFSITE_DRIVE_CLIENT_SECRET=
# NUQATI_OFFSITE_DRIVE_TOKEN=

# ── Background workers (teltonika, report_scheduler) ──────────────────
# Both show as unhealthy in Coolify when their heartbeat stops. Docker does not restart an unhealthy container
# by itself. Set this to a number of seconds (minimum 120, for example 600) to let a worker end its own process
# after that long without a heartbeat, so `restart: unless-stopped` starts a fresh one. 0 = off (default).
# NUQATI_WORKER_WATCHDOG_SECONDS=0

# ── Database migrations (Alembic) ──────────────────────────────────────
# The api container applies pending migrations (python -m app.migrate) before it starts and refuses to start if one
# fails. The first run on an existing database only records the baseline revision (nothing is changed) after checking
# that the database matches it. 0 = skip this: the database is then managed by hand, because the application itself no
# longer creates tables. See docs/DEVELOPMENT.md section 6.
# NUQATI_RUN_MIGRATIONS=1
