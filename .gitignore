# ── Python ────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.venv/
venv/
*.egg-info/

# ── Secrets & local configuration (never commit) ──────────────────────
.env
.env.*
!.env.example
*.jks
*.keystore
key.properties
local.properties
*.pem
*.p12
*.mobileprovision

# ── Local databases / dumps ───────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
*.dump
*.sql.gz

# ── Web (Vite / Node) ─────────────────────────────────────────────────
node_modules/
web/dist/
*.tsbuildinfo
.vite/

# ── Flutter / Dart ────────────────────────────────────────────────────
# Platform folders (android/, ios/) and lib/ are intentionally NOT ignored:
# commit them once they are generated and reviewed (see docs/DEVELOPMENT.md).
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
driver_app/build/
manager_app/build/
*.iml

# ── Build outputs: release binaries come from CI, not from git ────────
*.apk
*.aab
*.ipa

# ── OS / editors ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~
